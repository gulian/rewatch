# PostgreSQL — dedicated `rewatch` database
DATABASE_URL="postgresql://rewatch:CHANGEME@localhost:5432/rewatch"

# API
PORT=3020
HOST=127.0.0.1
NODE_ENV=production

# Set to "false" to close self-service signups (existing accounts still work)
REGISTRATION_ENABLED=true

# Daily job (release pushes, verification reminders) scheduled in-process, at
# "HH:MM" local time. Leave empty when an external cron or systemd timer already
# runs `node dist/jobs/daily.js`: both together send every release push twice.
DAILY_JOB_AT=""

# TMDB — v4 API key (Read Access Token), server-side only
TMDB_API_TOKEN=""
# Language of the base metadata cache (per-user fr/en translations are always fetched)
TMDB_LANGUAGE="en-US"

# TVmaze — keyless source of exact episode air instants and per-show broadcast
# timezones (no account, no admin setting: always on). Override the base URL only
# to point at the e2e stub server; leave empty in production.
TVMAZE_API_URL=""

# Public app URL (used in email links)
APP_URL="http://localhost:5173"

# SMTP — leave SMTP_HOST empty to disable email sending (links are logged instead)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rewatch <no-reply@example.com>"

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Trakt.tv OAuth app (Settings → Your API Apps), for two-way sync
TRAKT_CLIENT_ID=""
TRAKT_CLIENT_SECRET=""

# Optional legal/privacy page: who runs this instance and how to reach them.
# Only worth filling in if other people have accounts here.
LEGAL_HOST=""
LEGAL_CONTACT=""

# Let the API serve the built frontend itself instead of nginx/Caddy
# STATIC_DIR="../frontend/dist"

# Set to false only when the node port is exposed directly without a reverse
# proxy (otherwise clients could spoof X-Forwarded-For to dodge rate limits).
TRUST_PROXY=127.0.0.1
